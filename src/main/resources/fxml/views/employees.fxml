<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.PageTabs?>
<?import javafx.scene.control.Tab?>

<!-- Employees page (Stage 14): employees list (add, edit, inactive), daily attendance, and salary (month sheet, payments). -->
<PageTabs xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.eh.bms.controller.EmployeesController"
          fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="side-tabs">
    <Tab fx:id="listTab" text="%employee.tab.list">
        <fx:include fx:id="list" source="employees-list.fxml"/>
    </Tab>
    <Tab fx:id="attendanceTab" text="%employee.tab.attendance">
        <fx:include fx:id="attendance" source="attendance.fxml"/>
    </Tab>
    <Tab fx:id="salaryTab" text="%employee.tab.salary">
        <fx:include fx:id="salary" source="salary.fxml"/>
    </Tab>
</PageTabs>
