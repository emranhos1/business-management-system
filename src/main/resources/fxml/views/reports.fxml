<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.DateRangePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Reports (Stage 16): the list of reports on the left; on the right the filters of the chosen report (only the
     ones it uses show), the table, and the Excel export. -->
<HBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.ReportsController" spacing="16">
    <VBox spacing="8" minWidth="230" prefWidth="230" maxWidth="230">
        <Label text="%report.list_title" styleClass="section-title"/>
        <ListView fx:id="reportList" styleClass="report-list" VBox.vgrow="ALWAYS"/>
    </VBox>
    <VBox spacing="12" HBox.hgrow="ALWAYS" minWidth="0">
        <Label fx:id="titleLabel" styleClass="section-title"/>
        <!-- FlowPane: wraps to a second line when the page is narrow -->
        <FlowPane styleClass="toolbar" hgap="12" vgap="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="periodBox" prefWidth="130"/>
            <ComboBox fx:id="monthBox" prefWidth="125"/>
            <ComboBox fx:id="yearBox" prefWidth="90"/>
            <ComboBox fx:id="categoryBox" prefWidth="220"/>
            <StackPane fx:id="partyBox" styleClass="picker-box">
                <TextField fx:id="partyField" promptText="%report.party_all" prefWidth="260"/>
                <Region styleClass="picker-arrow" StackPane.alignment="CENTER_RIGHT" mouseTransparent="true"/>
            </StackPane>
            <DateRangePicker fx:id="dateRange" prefWidth="260"/>
            <Button text="%button.clear_filter" styleClass="cancel-button" onAction="#onClearFilters"/>
            <Button fx:id="exportButton" text="%report.export" styleClass="save-button" onAction="#onExport"/>
        </FlowPane>
        <Label fx:id="subtitleLabel" styleClass="stat-label"/>
        <TableView fx:id="table" VBox.vgrow="ALWAYS"/>
    </VBox>
</HBox>
