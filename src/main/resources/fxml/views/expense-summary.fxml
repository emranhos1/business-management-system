<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Monthly expense summary (13.4, a tab of the Expenses page): the month's total and the total per type on top,
     then each category's total, largest first. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.ExpenseSummaryController" spacing="12">
    <!-- FlowPane: wraps to a second line when the page is narrow -->
    <FlowPane styleClass="toolbar" hgap="12" vgap="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="monthBox" prefWidth="180"/>
        <ComboBox fx:id="yearBox" prefWidth="120"/>
        <Button text="%button.refresh" styleClass="page-button" onAction="#refresh"/>
        <Button text="%button.clear_filter" styleClass="cancel-button" onAction="#onClearFilter"/>
    </FlowPane>
    <FlowPane hgap="12" vgap="12">
        <VBox styleClass="stat-tile, stat-tile-main">
            <Label text="%expense.summary.total" styleClass="stat-label"/>
            <Label fx:id="totalLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label fx:id="operationalTitle" styleClass="stat-label"/>
            <Label fx:id="operationalLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label fx:id="overheadTitle" styleClass="stat-label"/>
            <Label fx:id="overheadLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label fx:id="otherTitle" styleClass="stat-label"/>
            <Label fx:id="otherLabel" styleClass="stat-value"/>
        </VBox>
    </FlowPane>
    <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>
</VBox>
