<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Sales return (11.7): how much of each line came back, money paid back (optional), date, note. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.SaleReturnFormController"
      styleClass="dialog-form" spacing="12" prefWidth="640">

    <Label fx:id="customerLabel" styleClass="form-label" wrapText="true"/>
    <Label text="%sale.return.hint" styleClass="field-hint" wrapText="true"/>

    <!-- One row per sale line: product, sold, already back, how many come back now -->
    <GridPane fx:id="linesGrid" hgap="10" vgap="6"/>
    <Label fx:id="linesError" styleClass="field-error" wrapText="true"/>

    <Label fx:id="valueLabel" styleClass="sale-grand" wrapText="true"/>

    <HBox styleClass="form-row">
        <Label text="%sale.return.refund" styleClass="form-label, form-row-label" wrapText="true"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="refundField" maxWidth="Infinity" promptText="0"/>
            <Label fx:id="refundError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="refundHint" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox fx:id="accountRow" styleClass="form-row">
        <Label text="%party.pay.account" styleClass="form-label, required, form-row-label" wrapText="true"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="accountBox" maxWidth="Infinity"/>
            <Label fx:id="accountError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.date" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
            <Label fx:id="dateError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.note" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextArea fx:id="noteField" maxWidth="Infinity" prefRowCount="2" wrapText="true"/>
            <Label fx:id="noteError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="dialog-buttons">
        <Button text="%button.cancel" styleClass="cancel-button" cancelButton="true" onAction="#onCancel"/>
        <Button text="%sale.action.return" styleClass="save-button" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
