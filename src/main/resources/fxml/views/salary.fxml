<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Salary tab of the users page (14.3 - 14.5, N12): pick a month (this month at first); every user's salary for it
     with what is paid and due. Each row: salary (work out and pay), history. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.SalaryController" spacing="12">
    <!-- FlowPane: wraps to a second line when the page is narrow -->
    <FlowPane styleClass="toolbar" hgap="12" vgap="8" alignment="CENTER_LEFT">
        <ComboBox fx:id="monthBox" prefWidth="180"/>
        <ComboBox fx:id="yearBox" prefWidth="120"/>
        <Button text="%button.refresh" styleClass="page-button" onAction="#reload"/>
        <Button text="%button.clear_filter" styleClass="cancel-button" onAction="#onClearFilter"/>
    </FlowPane>
    <FlowPane hgap="12" vgap="12">
        <VBox styleClass="stat-tile, stat-tile-main">
            <Label text="%salary.total_net" styleClass="stat-label"/>
            <Label fx:id="totalNetLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%salary.total_carry" styleClass="stat-label"/>
            <Label fx:id="totalCarryLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%salary.total_paid" styleClass="stat-label"/>
            <Label fx:id="totalPaidLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%salary.total_due" styleClass="stat-label"/>
            <Label fx:id="totalDueLabel" styleClass="stat-value"/>
        </VBox>
    </FlowPane>
    <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS" minHeight="260"/>
</VBox>
