<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Salary payment (14.4): an advance before the month is worked out, or part of it after. One field per row
     (label 200 px, input fills the rest). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.SalaryPaymentFormController"
      styleClass="dialog-form" spacing="12" prefWidth="540">

    <HBox styleClass="form-row">
        <Label text="%salary.employee" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <Label fx:id="employeeLabel" styleClass="form-label" wrapText="true"/>
            <Label fx:id="salaryLabel" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%salary.month" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <HBox spacing="8">
                <ComboBox fx:id="monthBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="yearBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="monthError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="dueLabel" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.amount" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="amountField" maxWidth="Infinity"/>
            <Label fx:id="amountError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <!-- Emergency advance: may go above the month's due; the extra counts for the next months -->
    <HBox styleClass="form-row">
        <Label text="%salary.pay.emergency" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <HBox styleClass="check-row" alignment="CENTER_LEFT">
                <CheckBox fx:id="emergencyBox"/>
            </HBox>
            <Label text="%salary.pay.emergency_hint" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%salary.pay.account" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="accountBox" maxWidth="Infinity"/>
            <Label fx:id="accountError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="accountBalanceLabel" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.date" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
            <Label fx:id="dateError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.note" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextArea fx:id="noteField" maxWidth="Infinity" prefRowCount="3" wrapText="true"/>
            <Label fx:id="noteError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="dialog-buttons">
        <!-- Only when editing a payment, for users who may delete -->
        <Button fx:id="deleteButton" text="%button.delete" styleClass="delete-button" onAction="#onDelete"
                visible="false" managed="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%button.cancel" styleClass="cancel-button" cancelButton="true" onAction="#onCancel"/>
        <Button fx:id="saveButton" styleClass="save-button" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
