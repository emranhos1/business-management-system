<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Expense categories (13.1, beside the list on the Expenses page): add; edit on each row; delete in the edit form. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.ExpenseCategoriesController" spacing="12">
    <!-- One line: title on the left, button pushed to the right -->
    <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
        <Label text="%expense.category.title" styleClass="section-title" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button fx:id="addButton" text="%expense.category.add" styleClass="add-button" onAction="#onAdd"/>
    </HBox>
    <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>
</VBox>
