<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.TwoColumnLayout?>

<!-- Expenses page (Stage 13), one page, no tabs (user decision): the month's expenses grouped by category on the left,
     the expense categories on the right; stacked on a narrow window. -->
<TwoColumnLayout xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
                 fx:controller="com.eh.bms.controller.ExpensesController" mainPercent="68">
    <fx:include fx:id="list" source="expenses-list.fxml"/>
    <fx:include fx:id="categories" source="expense-categories.fxml"/>
</TwoColumnLayout>
