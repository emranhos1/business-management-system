<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Salary popup (N12): work out a user's month and pay in one save. One field per row (label 200 px, input fills
     the rest). Gross, net and due follow the typed values; the money part is optional. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.SalaryFormController"
      styleClass="dialog-form" spacing="12" prefWidth="540">

    <HBox styleClass="form-row">
        <Label text="%salary.employee" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <Label fx:id="userLabel" styleClass="form-label" wrapText="true"/>
            <Label fx:id="salaryLabel" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%salary.month" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <HBox spacing="8">
                <ComboBox fx:id="monthBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                <ComboBox fx:id="yearBox" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
            </HBox>
            <Label fx:id="monthError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="paidLabel" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <!-- Days (daily) or hours (hourly) worked; hidden for a monthly salary -->
    <HBox fx:id="unitsRow" styleClass="form-row">
        <Label fx:id="unitsCaption" styleClass="form-label, required, form-row-label" wrapText="true"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="unitsField" maxWidth="Infinity"/>
            <Label fx:id="unitsError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%salary.deductions" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="deductionsField" maxWidth="Infinity"/>
            <Label fx:id="deductionsError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <!-- Required while there is a deduction -->
    <HBox styleClass="form-row">
        <Label fx:id="reasonCaption" text="%salary.reason" styleClass="form-label, form-row-label" wrapText="true"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="reasonField" maxWidth="Infinity"/>
            <Label fx:id="reasonError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%salary.bonus" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="bonusField" maxWidth="Infinity"/>
            <Label fx:id="bonusError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%salary.gross" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <Label fx:id="grossLabel" styleClass="form-label" wrapText="true"/>
            <Label fx:id="grossHint" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%salary.net" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <Label fx:id="netLabel" styleClass="form-label" wrapText="true"/>
            <Label fx:id="netError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="dueLabel" wrapText="true"/>
        </VBox>
    </HBox>

    <Label text="%salary.pay_now" styleClass="section-title"/>

    <HBox styleClass="form-row">
        <Label text="%salary.pay.account" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="accountBox" maxWidth="Infinity"/>
            <Label fx:id="accountError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="accountBalanceLabel" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.amount" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="amountField" maxWidth="Infinity"/>
            <Label fx:id="amountError" styleClass="field-error" wrapText="true"/>
            <Label text="%salary.pay_now.hint" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <!-- Emergency advance: may go above the month's due; the extra counts for the next months -->
    <HBox styleClass="form-row">
        <Label text="%salary.pay.emergency" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <HBox styleClass="check-row" alignment="CENTER_LEFT">
                <CheckBox fx:id="emergencyBox"/>
            </HBox>
            <Label text="%salary.pay.emergency_hint" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.date" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <DatePicker fx:id="datePicker" maxWidth="Infinity"/>
            <Label fx:id="dateError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="dialog-buttons">
        <Button text="%button.cancel" styleClass="cancel-button" cancelButton="true" onAction="#onCancel"/>
        <Button text="%button.save" styleClass="save-button" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
