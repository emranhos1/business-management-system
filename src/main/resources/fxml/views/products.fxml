<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.TwoColumnLayout?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Products page: products on the left (8.2); on the right, tabs for product categories (8.1) and
     units (8.4), each with its own FXML + controller; stacked on a narrow window. -->
<TwoColumnLayout xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
                 fx:controller="com.eh.bms.controller.ProductsController">

    <VBox spacing="12">
        <!-- One line: title on the left, button pushed to the right -->
        <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
            <Label text="%products.section.products" styleClass="section-title" minWidth="-Infinity"/>
            <Region HBox.hgrow="ALWAYS" minWidth="8"/>
            <Button fx:id="addButton" text="%products.add" styleClass="add-button" onAction="#onAdd"/>
        </HBox>
        <StackPane fx:id="productsHolder" VBox.vgrow="ALWAYS"/>
    </VBox>

    <TabPane tabClosingPolicy="UNAVAILABLE" styleClass="side-tabs">
        <Tab text="%products.tab.categories">
            <fx:include fx:id="categories" source="product-categories.fxml"/>
        </Tab>
        <Tab text="%products.tab.units">
            <fx:include fx:id="units" source="units.fxml"/>
        </Tab>
    </TabPane>
</TwoColumnLayout>
