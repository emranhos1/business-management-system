<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<!-- Add / edit account popup (7.1). One field per row (label 200 px, input fills the rest).
     Rows are HBoxes, so the hidden account number row takes no space at all. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.AccountFormController"
      styleClass="dialog-form" spacing="12" prefWidth="540">

    <HBox styleClass="form-row">
        <Label text="%accounts.name_bn" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="nameField" maxWidth="Infinity"/>
            <Label fx:id="nameError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%accounts.name_en" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="nameEnField" maxWidth="Infinity"/>
            <Label fx:id="nameEnError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%accounts.type" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="typeBox" maxWidth="Infinity"/>
            <Label fx:id="typeError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox fx:id="numberRow" styleClass="form-row" visible="false" managed="false">
        <Label text="%accounts.number" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="numberField" maxWidth="Infinity"/>
            <Label fx:id="numberError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%accounts.opening" styleClass="form-label, required, form-row-label" wrapText="true"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="openingField" maxWidth="Infinity"/>
            <Label fx:id="openingError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="openingLockedLabel" text="%accounts.opening.locked" styleClass="field-hint"
                   wrapText="true" visible="false" managed="false"/>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="dialog-buttons">
        <Button text="%button.cancel" styleClass="cancel-button" cancelButton="true" onAction="#onCancel"/>
        <Button text="%button.save" styleClass="save-button" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
