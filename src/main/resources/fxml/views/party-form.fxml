<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Add / edit party popup (10.1). One field per row (label 200 px, input fills the rest). -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.PartyFormController"
      styleClass="dialog-form" spacing="12" prefWidth="540">

    <HBox styleClass="form-row">
        <Label text="%party.name_bn" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="nameField" maxWidth="Infinity"/>
            <Label fx:id="nameError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%party.name_en" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="nameEnField" maxWidth="Infinity"/>
            <Label fx:id="nameEnError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%party.phone" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="phoneField" maxWidth="Infinity" promptText="01XXXXXXXXX"/>
            <Label fx:id="phoneError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%label.address" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="addressField" maxWidth="Infinity"/>
            <Label fx:id="addressError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%party.type" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="typeBox" maxWidth="Infinity"/>
            <Label fx:id="typeError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%party.trade" styleClass="form-label, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="tradeBox" maxWidth="Infinity" promptText="%party.trade.prompt"/>
            <Label fx:id="tradeError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%party.opening" styleClass="form-label, required, form-row-label" wrapText="true"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="openingField" maxWidth="Infinity"/>
            <Label fx:id="openingError" styleClass="field-error" wrapText="true"/>
            <Label text="%party.opening.hint" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <!-- Shown only when the opening amount is more than 0 -->
    <HBox fx:id="directionRow" styleClass="form-row" visible="false" managed="false">
        <Label text="%party.opening.direction" styleClass="form-label, required, form-row-label" wrapText="true"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="directionBox" maxWidth="Infinity"/>
            <Label fx:id="directionError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <Label fx:id="openingLockedLabel" text="%party.opening.locked" styleClass="field-hint"
           wrapText="true" visible="false" managed="false"/>

    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="dialog-buttons">
        <!-- Only when editing a party with no history and no earlier balance (a mistake to remove) -->
        <Button fx:id="deleteButton" text="%button.delete" styleClass="delete-button" onAction="#onDelete"
                visible="false" managed="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%button.cancel" styleClass="cancel-button" cancelButton="true" onAction="#onCancel"/>
        <Button text="%button.save" styleClass="save-button" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
