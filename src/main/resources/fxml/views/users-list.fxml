<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Users (17.1, 17.2): three lists side by side, equal width: registrations waiting for approval (N1, only while
     there are any), active users with edit and deactivate buttons on each row, inactive users. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.UsersListController" spacing="12">

    <!-- One line: title on the left; search, then New user on the right -->
    <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
        <Label text="%user.section" styleClass="section-title" minWidth="-Infinity"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <TextField fx:id="searchField" promptText="%user.search" prefWidth="360" minWidth="160"/>
        <Button text="%button.clear_filter" styleClass="cancel-button" onAction="#onClearSearch"/>
        <Button fx:id="addButton" text="%user.add" styleClass="add-button" onAction="#onAdd"/>
    </HBox>

    <!-- prefWidth 0 + grow: the shown lists share the width equally -->
    <HBox spacing="16" VBox.vgrow="ALWAYS" minHeight="320">
        <VBox fx:id="pendingBox" spacing="12" HBox.hgrow="ALWAYS" prefWidth="0" visible="false" managed="false">
            <Label text="%user.section.pending" styleClass="section-title"/>
            <StackPane fx:id="pendingHolder" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="12" HBox.hgrow="ALWAYS" prefWidth="0">
            <Label text="%user.section.active" styleClass="section-title"/>
            <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>
        </VBox>
        <VBox spacing="12" HBox.hgrow="ALWAYS" prefWidth="0">
            <Label text="%user.section.inactive" styleClass="section-title"/>
            <StackPane fx:id="inactiveHolder" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>
</VBox>
