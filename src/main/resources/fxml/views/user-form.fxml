<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Add / edit user popup (17.1). One field per row. The password is required for a new user; when editing,
     blank keeps the old one. The username cannot change after the user is saved. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.UserFormController"
      styleClass="dialog-form" spacing="12" prefWidth="540">

    <HBox styleClass="form-row">
        <Label text="%user.name" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="nameField" maxWidth="Infinity"/>
            <Label fx:id="nameError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%user.username" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <TextField fx:id="usernameField" maxWidth="Infinity"/>
            <Label fx:id="usernameError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="usernameHint" text="%user.username.hint_locked" styleClass="field-hint" wrapText="true"
                   visible="false" managed="false"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label fx:id="passwordLabel" text="%user.password" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <PasswordField fx:id="passwordField" maxWidth="Infinity"/>
            <Label fx:id="passwordError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="passwordHint" text="%user.password.hint_new" styleClass="field-hint" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label fx:id="confirmLabel" text="%user.password_confirm" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <PasswordField fx:id="confirmField" maxWidth="Infinity"/>
            <Label fx:id="confirmError" styleClass="field-error" wrapText="true"/>
        </VBox>
    </HBox>

    <HBox styleClass="form-row">
        <Label text="%user.role" styleClass="form-label, required, form-row-label"/>
        <VBox styleClass="field-box" HBox.hgrow="ALWAYS">
            <ComboBox fx:id="roleBox" maxWidth="Infinity"/>
            <Label fx:id="roleError" styleClass="field-error" wrapText="true"/>
            <Label fx:id="roleHint" text="%user.role.hint_self" styleClass="field-hint" wrapText="true"
                   visible="false" managed="false"/>
        </VBox>
    </HBox>

    <HBox spacing="8" alignment="CENTER_RIGHT" styleClass="dialog-buttons">
        <!-- Only when editing a user who can be deleted (added by mistake, no history) -->
        <Button fx:id="deleteButton" text="%button.delete" styleClass="delete-button" onAction="#onDelete"
                visible="false" managed="false"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="%button.cancel" styleClass="cancel-button" cancelButton="true" onAction="#onCancel"/>
        <Button text="%button.save" styleClass="save-button" defaultButton="true" onAction="#onSave"/>
    </HBox>
</VBox>
