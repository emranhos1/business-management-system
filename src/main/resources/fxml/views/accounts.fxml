<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.TwoColumnLayout?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Accounts page (7.1-7.4): accounts with balances on the left (ledger, transfer),
     account types on the right (own FXML + controller); stacked on a narrow window. -->
<TwoColumnLayout xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
                 fx:controller="com.eh.bms.controller.AccountsController">

    <VBox spacing="12">
        <!-- One line: title on the left, buttons pushed to the right -->
        <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
            <Label text="%accounts.section.accounts" styleClass="section-title" minWidth="-Infinity"/>
            <Region HBox.hgrow="ALWAYS" minWidth="8"/>
            <Button fx:id="addButton" text="%accounts.add" styleClass="add-button" onAction="#onAdd"/>
            <Button fx:id="transferButton" text="%accounts.transfer" styleClass="add-button" onAction="#onTransfer"/>
        </HBox>
        <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>
    </VBox>

    <fx:include fx:id="types" source="account-types.fxml"/>
</TwoColumnLayout>
