<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Account ledger window (7.2): summary figures on top, entries (newest first) below. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.AccountLedgerController"
      styleClass="ledger-window" spacing="16">

    <FlowPane hgap="12" vgap="12">
        <VBox styleClass="stat-tile, stat-tile-main">
            <Label text="%ledger.current" styleClass="stat-label"/>
            <Label fx:id="balanceLabel" styleClass="stat-value"/>
        </VBox>
        <!-- Only when the account was opened with money, so in/out and the balance add up -->
        <VBox fx:id="openingTile" styleClass="stat-tile" visible="false" managed="false">
            <Label text="%ledger.opening" styleClass="stat-label"/>
            <Label fx:id="openingLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%ledger.total_in" styleClass="stat-label"/>
            <Label fx:id="totalInLabel" styleClass="stat-value, money-in"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%ledger.total_out" styleClass="stat-label"/>
            <Label fx:id="totalOutLabel" styleClass="stat-value, money-out"/>
        </VBox>
    </FlowPane>

    <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="%button.close" styleClass="cancel-button" cancelButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
