<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Tab?>
<?import com.eh.bms.util.PageTabs?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Stock page: current stock per product (9.3: ledger, adjustment), low stock list (9.6) and
     stock value (9.7); the last two have their own FXML + controller. -->
<PageTabs xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.eh.bms.controller.StockController"
         fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="side-tabs">
    <Tab text="%stock.tab.current">
        <VBox spacing="12">
            <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="%stock.search.prompt" prefWidth="320" minWidth="160"/>
                <Button text="%button.clear_filter" styleClass="cancel-button" onAction="#onClearSearch"/>
            </HBox>
            <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>
        </VBox>
    </Tab>
    <Tab fx:id="lowTab" text="%stock.tab.low">
        <fx:include fx:id="low" source="low-stock.fxml"/>
    </Tab>
    <Tab fx:id="valueTab" text="%stock.tab.value">
        <fx:include fx:id="value" source="stock-valuation.fxml"/>
    </Tab>
</PageTabs>
