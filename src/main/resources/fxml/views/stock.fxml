<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Stock page: current stock per product (9.3: ledger, adjustment), low stock list (9.6) and
     stock value (9.7); the last two have their own FXML + controller. -->
<TabPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.eh.bms.controller.StockController"
         tabClosingPolicy="UNAVAILABLE" styleClass="side-tabs">
    <Tab text="%stock.tab.current">
        <VBox spacing="12">
            <HBox styleClass="toolbar" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="%stock.search.prompt" prefWidth="320" minWidth="160"/>
            </HBox>
            <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>
        </VBox>
    </Tab>
    <Tab text="%stock.tab.low">
        <fx:include source="low-stock.fxml"/>
    </Tab>
    <Tab text="%stock.tab.value">
        <fx:include source="stock-valuation.fxml"/>
    </Tab>
</TabPane>
