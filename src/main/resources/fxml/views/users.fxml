<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.PageTabs?>
<?import javafx.scene.control.Tab?>

<!-- Users page (Stage 17, admin only): users (add, edit, inactive), permissions of each role, and the audit log. -->
<PageTabs xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.eh.bms.controller.UsersController"
          fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="side-tabs">
    <Tab fx:id="listTab" text="%user.tab.users">
        <fx:include fx:id="list" source="users-list.fxml"/>
    </Tab>
    <Tab fx:id="permissionTab" text="%user.tab.permissions">
        <fx:include fx:id="permission" source="permissions.fxml"/>
    </Tab>
    <Tab fx:id="auditTab" text="%user.tab.audit">
        <fx:include fx:id="audit" source="audit-log.fxml"/>
    </Tab>
</PageTabs>
