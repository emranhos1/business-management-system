<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.PageTabs?>
<?import javafx.scene.control.Tab?>

<!-- Sales page (Stage 11): new sale, and the sales list (search, view, installment, return). -->
<PageTabs xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
          fx:controller="com.eh.bms.controller.SalesController"
          fx:id="tabs" tabClosingPolicy="UNAVAILABLE" styleClass="side-tabs">
    <Tab fx:id="entryTab" text="%sale.tab.new">
        <fx:include fx:id="entry" source="sale-entry.fxml"/>
    </Tab>
    <Tab fx:id="listTab" text="%sale.tab.list">
        <fx:include fx:id="list" source="sales-list.fxml"/>
    </Tab>
</PageTabs>
