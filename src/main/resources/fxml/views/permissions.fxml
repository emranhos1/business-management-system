<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<!-- Permissions (17.3): pick a role, tick what it may do in each section, save. Applies from the next login. -->
<VBox fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.PermissionsController" spacing="12">
    <HBox styleClass="toolbar" spacing="8" alignment="CENTER_LEFT">
        <Label text="%permission.role" styleClass="section-title" minWidth="-Infinity"/>
        <ComboBox fx:id="roleBox" prefWidth="200"/>
        <Region HBox.hgrow="ALWAYS" minWidth="8"/>
        <Button fx:id="saveButton" text="%permission.save" styleClass="save-button" onAction="#onSave"/>
    </HBox>
    <Label text="%permission.hint" styleClass="field-hint" wrapText="true"/>
    <GridPane fx:id="grid" hgap="24" vgap="10"/>
</VBox>
