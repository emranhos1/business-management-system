<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Party ledger window (10.3): figures on top, entries (newest first) below, in plain words. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.PartyLedgerController"
      styleClass="ledger-window" spacing="16">

    <FlowPane hgap="12" vgap="12">
        <VBox styleClass="stat-tile, stat-tile-main">
            <Label text="%party.ledger.current" styleClass="stat-label"/>
            <Label fx:id="balanceLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%party.ledger.opening" styleClass="stat-label"/>
            <Label fx:id="openingLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%party.ledger.total_gave" styleClass="stat-label"/>
            <Label fx:id="totalGaveLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%party.ledger.total_got" styleClass="stat-label"/>
            <Label fx:id="totalGotLabel" styleClass="stat-value"/>
        </VBox>
    </FlowPane>

    <Label text="%party.ledger.hint" styleClass="field-hint" wrapText="true"/>

    <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="%button.close" styleClass="cancel-button" cancelButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
