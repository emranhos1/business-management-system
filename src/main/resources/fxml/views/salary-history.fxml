<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- One employee's salary history (14.5): totals on top, then each month (newest first), then every payment. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.SalaryHistoryController"
      styleClass="ledger-window" spacing="12">

    <FlowPane hgap="12" vgap="12">
        <VBox styleClass="stat-tile, stat-tile-main">
            <Label text="%salary.total_net" styleClass="stat-label"/>
            <Label fx:id="totalNetLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%salary.total_paid" styleClass="stat-label"/>
            <Label fx:id="totalPaidLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%salary.total_due" styleClass="stat-label"/>
            <Label fx:id="totalDueLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%salary.total_advance_left" styleClass="stat-label"/>
            <Label fx:id="totalAdvanceLabel" styleClass="stat-value"/>
        </VBox>
    </FlowPane>

    <Label text="%salary.history.months" styleClass="section-title"/>
    <StackPane fx:id="monthsHolder" VBox.vgrow="ALWAYS" minHeight="160"/>

    <Label text="%salary.history.payments" styleClass="section-title"/>
    <StackPane fx:id="paymentsHolder" VBox.vgrow="ALWAYS" minHeight="160"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="%button.close" styleClass="cancel-button" cancelButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
