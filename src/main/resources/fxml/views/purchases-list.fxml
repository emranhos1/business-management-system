<?xml version="1.0" encoding="UTF-8"?>

<?import com.eh.bms.util.DateRangePicker?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Purchases list (12.3): search by memo no., supplier, supplier's memo no. or note, a date range and product;
     each row: view, payment, return. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.PurchasesListController" spacing="12">
    <FlowPane styleClass="toolbar" hgap="12" vgap="8" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="%purchase.search" prefWidth="300"/>
        <DateRangePicker fx:id="dateRange" prefWidth="260"/>
        <StackPane styleClass="picker-box">
            <TextField fx:id="productFilterField" promptText="%sale.filter.product" prefWidth="260"/>
            <Region styleClass="picker-arrow" StackPane.alignment="CENTER_RIGHT" mouseTransparent="true"/>
        </StackPane>
        <Button text="%button.clear_filter" styleClass="cancel-button" onAction="#onClearFilters"/>
    </FlowPane>
    <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>
</VBox>
