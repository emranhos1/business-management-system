<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Daily attendance (14.2, a tab of the Employees page). Day sheet: pick a day (today at first, no future
     day), every employee on one table with status, in / out time and note, saved all at once. Present comes
     saved automatically on work days; only the exceptions are changed. Month view:
     present / half day / leave / absent per employee for a month. -->
<VBox fx:id="root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.AttendanceController" spacing="12">

    <VBox fx:id="dayView" spacing="12" VBox.vgrow="ALWAYS">
        <!-- FlowPane: wraps to a second line when the page is narrow -->
        <FlowPane styleClass="toolbar" hgap="12" vgap="8" alignment="CENTER_LEFT">
            <DatePicker fx:id="datePicker" prefWidth="180"/>
            <Label fx:id="dayLabel"/>
            <Button fx:id="saveButton" text="%button.save" styleClass="save-button" onAction="#onSave"/>
            <Button text="%attendance.month_view" styleClass="view-button" onAction="#onShowMonth"/>
        </FlowPane>
        <Label text="%attendance.hint.auto" styleClass="field-hint" wrapText="true"/>
        <Label text="%attendance.hint.hourly" styleClass="field-hint" wrapText="true"/>
        <Label fx:id="notSavedHint" styleClass="field-hint" wrapText="true"/>
        <TableView fx:id="dayTable" VBox.vgrow="ALWAYS"/>
        <Label fx:id="errorLabel" styleClass="field-error" wrapText="true"/>
    </VBox>

    <VBox fx:id="monthView" spacing="12" VBox.vgrow="ALWAYS" visible="false" managed="false">
        <FlowPane styleClass="toolbar" hgap="12" vgap="8" alignment="CENTER_LEFT">
            <ComboBox fx:id="monthBox" prefWidth="180"/>
            <ComboBox fx:id="yearBox" prefWidth="120"/>
            <Button text="%attendance.day_view" styleClass="view-button" onAction="#onShowDay"/>
        </FlowPane>
        <StackPane fx:id="monthTableHolder" VBox.vgrow="ALWAYS"/>
    </VBox>
</VBox>
