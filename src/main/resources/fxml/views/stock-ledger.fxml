<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Stock ledger window (9.4): one product's stock figures on top, entries (newest first) below. Read-only. -->
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.eh.bms.controller.StockLedgerController"
      styleClass="ledger-window" spacing="16">

    <FlowPane hgap="12" vgap="12">
        <VBox styleClass="stat-tile, stat-tile-main">
            <Label text="%stock.ledger.current" styleClass="stat-label"/>
            <Label fx:id="currentStockLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%stock.ledger.average_cost" styleClass="stat-label"/>
            <Label fx:id="averageCostLabel" styleClass="stat-value"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%stock.ledger.total_in" styleClass="stat-label"/>
            <Label fx:id="totalInLabel" styleClass="stat-value, money-in"/>
        </VBox>
        <VBox styleClass="stat-tile">
            <Label text="%stock.ledger.total_out" styleClass="stat-label"/>
            <Label fx:id="totalOutLabel" styleClass="stat-value, money-out"/>
        </VBox>
    </FlowPane>

    <StackPane fx:id="tableHolder" VBox.vgrow="ALWAYS"/>

    <HBox alignment="CENTER_RIGHT">
        <Button text="%button.close" styleClass="cancel-button" cancelButton="true" onAction="#onClose"/>
    </HBox>
</VBox>
