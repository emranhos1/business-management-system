<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Settings: business profile (6.1) and app settings incl. language (6.2, 6.3). -->
<TabPane fx:id="tabPane" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
         fx:controller="com.eh.bms.controller.SettingsController"
         tabClosingPolicy="UNAVAILABLE" styleClass="settings-tabs">

    <Tab text="%settings.tab.business">
        <ScrollPane fitToWidth="true" styleClass="form-scroll">
            <VBox styleClass="form-card" spacing="16" maxWidth="640">
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="170" prefWidth="170"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%settings.business.name" styleClass="form-label, required"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <TextField fx:id="nameField" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="%label.address" styleClass="form-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <TextArea fx:id="addressField" prefRowCount="2" wrapText="true"
                              GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                    <Label text="%label.phone" styleClass="form-label"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <TextField fx:id="phoneField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="%label.email" styleClass="form-label"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <TextField fx:id="emailField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="%settings.business.currency" styleClass="form-label, required"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <TextField fx:id="currencyField" maxWidth="120" GridPane.rowIndex="4" GridPane.columnIndex="1"/>

                    <Label text="%settings.business.vat" styleClass="form-label, required"
                           GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                    <TextField fx:id="vatField" maxWidth="120" GridPane.rowIndex="5" GridPane.columnIndex="1"/>

                    <Label text="%settings.business.fy_start" styleClass="form-label"
                           GridPane.rowIndex="6" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="fyStartBox" prefWidth="200" GridPane.rowIndex="6" GridPane.columnIndex="1"/>

                    <Label text="%settings.business.logo" styleClass="form-label"
                           GridPane.rowIndex="7" GridPane.columnIndex="0"/>
                    <HBox spacing="16" alignment="CENTER_LEFT" GridPane.rowIndex="7" GridPane.columnIndex="1">
                        <StackPane styleClass="logo-box" minWidth="88" minHeight="88" maxWidth="88" maxHeight="88">
                            <ImageView fx:id="logoView" fitWidth="80" fitHeight="80" preserveRatio="true" smooth="true"/>
                            <Label fx:id="noLogoLabel" text="%settings.logo.none" styleClass="placeholder-text"
                                   wrapText="true" textAlignment="CENTER" maxWidth="72"/>
                        </StackPane>
                        <VBox spacing="8">
                            <Button text="%settings.logo.choose" onAction="#onChooseLogo"/>
                            <Button fx:id="removeLogoButton" text="%settings.logo.remove" onAction="#onRemoveLogo"/>
                        </VBox>
                    </HBox>
                </GridPane>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="saveProfileButton" text="%button.save" styleClass="primary-button"
                            onAction="#onSaveProfile"/>
                    <Label fx:id="profileStatus" wrapText="true"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </Tab>

    <Tab text="%settings.tab.app">
        <ScrollPane fitToWidth="true" styleClass="form-scroll">
            <VBox styleClass="form-card" spacing="16" maxWidth="640">
                <GridPane hgap="16" vgap="12">
                    <columnConstraints>
                        <ColumnConstraints minWidth="200" prefWidth="200"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%settings.language" styleClass="form-label"
                           GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                    <ComboBox fx:id="languageBox" prefWidth="200" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                    <Label text="%settings.date_format" styleClass="form-label"
                           GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                    <HBox spacing="12" alignment="CENTER_LEFT" GridPane.rowIndex="1" GridPane.columnIndex="1">
                        <ComboBox fx:id="dateFormatBox" prefWidth="200"/>
                        <Label fx:id="dateExampleLabel" styleClass="placeholder-text"/>
                    </HBox>

                    <Label text="%settings.items_per_page" styleClass="form-label"
                           GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                    <Spinner fx:id="itemsPerPageSpinner" editable="true" prefWidth="120"
                             GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                    <Label text="%settings.low_stock_default" styleClass="form-label"
                           GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                    <Spinner fx:id="lowStockSpinner" editable="true" prefWidth="120"
                             GridPane.rowIndex="3" GridPane.columnIndex="1"/>

                    <Label text="%settings.auto_backup" styleClass="form-label" wrapText="true"
                           GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                    <CheckBox fx:id="autoBackupBox" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                </GridPane>

                <HBox spacing="12" alignment="CENTER_LEFT">
                    <Button fx:id="saveAppButton" text="%button.save" styleClass="primary-button"
                            onAction="#onSaveApp"/>
                    <Label fx:id="appStatus" wrapText="true"/>
                </HBox>
            </VBox>
        </ScrollPane>
    </Tab>
</TabPane>
