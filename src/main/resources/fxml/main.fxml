<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Main layout: sidebar on the left, header + message bar on top, the selected view in the center. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eh.bms.controller.MainController">
    <left>
        <VBox styleClass="sidebar" prefWidth="250" minWidth="250">
            <HBox styleClass="sidebar-brand" spacing="10" alignment="CENTER_LEFT">
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true" smooth="true">
                    <Image url="@../icons/bms-64.png"/>
                </ImageView>
                <Label fx:id="brandLabel" styleClass="sidebar-brand-text" wrapText="true"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="menuBox" styleClass="sidebar-menu" spacing="2"/>
            </ScrollPane>

            <!-- Language switch + time, then logout + today's date (date format setting) -->
            <HBox styleClass="sidebar-footer" spacing="8" alignment="CENTER_LEFT">
                <!-- minWidth = pref width, so the buttons never shrink to "..." -->
                <HBox minWidth="-Infinity">
                    <Button fx:id="bnButton" text="BN" styleClass="lang-button" minWidth="-Infinity" onAction="#onBangla"/>
                    <Button fx:id="enButton" text="EN" styleClass="lang-button" minWidth="-Infinity" onAction="#onEnglish"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="timeLabel" styleClass="clock-box" minWidth="-Infinity"/>
            </HBox>
            <HBox styleClass="sidebar-bottom" spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="logoutButton" styleClass="sidebar-button, sidebar-logout" minWidth="-Infinity"
                        onAction="#onLogout"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="dateLabel" styleClass="clock-box" minWidth="-Infinity"/>
            </HBox>
        </VBox>
    </left>

    <center>
        <!-- id: popups open centered on this part (everything right of the sidebar) -->
        <BorderPane id="workArea">
            <top>
                <VBox>
                    <HBox styleClass="header" spacing="12" alignment="CENTER_LEFT">
                        <Label fx:id="pageTitleLabel" styleClass="header-title"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Label fx:id="userLabel" styleClass="header-user"/>
                    </HBox>
                    <!-- Success/error messages (Notifier); takes no space while empty -->
                    <StackPane fx:id="messageBar" styleClass="message-bar" alignment="CENTER_LEFT"
                               visible="false" managed="false"/>
                </VBox>
            </top>
            <center>
                <!-- The page fills the space; on a small window (or stacked parts) it scrolls instead of being cut -->
                <!-- min 0: the scroll never gets wider/taller than the window (its content scrolls instead) -->
                <ScrollPane fitToWidth="true" fitToHeight="true" styleClass="page-scroll" minWidth="0" minHeight="0">
                    <StackPane fx:id="contentArea" styleClass="content-area"/>
                </ScrollPane>
            </center>
        </BorderPane>
    </center>
</BorderPane>
