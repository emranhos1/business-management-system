<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Main layout: sidebar on the left, header on top, the selected view in the center. -->
<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.eh.bms.controller.MainController">
    <left>
        <VBox styleClass="sidebar" prefWidth="230">
            <HBox styleClass="sidebar-brand" spacing="10" alignment="CENTER_LEFT">
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true" smooth="true">
                    <Image url="@../icons/bms-64.png"/>
                </ImageView>
                <Label fx:id="brandLabel" styleClass="sidebar-brand-text" wrapText="true"/>
            </HBox>

            <ScrollPane fitToWidth="true" styleClass="sidebar-scroll" VBox.vgrow="ALWAYS">
                <VBox fx:id="menuBox" styleClass="sidebar-menu" spacing="2"/>
            </ScrollPane>

            <Button fx:id="logoutButton" styleClass="sidebar-button, sidebar-logout"
                    maxWidth="Infinity" onAction="#onLogout"/>
        </VBox>
    </left>

    <center>
        <BorderPane>
            <top>
                <HBox styleClass="header" spacing="12" alignment="CENTER_LEFT">
                    <Label fx:id="pageTitleLabel" styleClass="header-title"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="userLabel" styleClass="header-user"/>
                </HBox>
            </top>
            <center>
                <StackPane fx:id="contentArea" styleClass="content-area"/>
            </center>
        </BorderPane>
    </center>
</BorderPane>
