<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?><?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<!-- Texts are bound in LoginController so they follow language changes. -->
<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.eh.bms.controller.LoginController">
    <padding><Insets top="40" right="40" bottom="40" left="40"/></padding>

    <VBox spacing="12" alignment="CENTER">
        <!-- Shown only when GitHub has a newer release (checked in the background); the window grows for it -->
        <VBox fx:id="updateBanner" styleClass="update-banner" spacing="8" visible="false" managed="false"
              minWidth="360" prefWidth="360" maxWidth="360">
            <Label fx:id="updateLabel" styleClass="update-title" wrapText="true"/>
            <HBox spacing="8" alignment="CENTER_LEFT">
                <Button fx:id="updateButton" styleClass="update-button" onAction="#onUpdate"/>
                <Button fx:id="notesButton" styleClass="view-button" onAction="#onShowNotes"/>
            </HBox>
            <!-- fixed height: the login window is not resizable, so the bar would be squeezed to a line -->
            <ProgressBar fx:id="updateProgress" maxWidth="Infinity" minHeight="14" prefHeight="14"
                         visible="false" managed="false"/>
            <Label fx:id="updateError" styleClass="error-label" wrapText="true"/>
        </VBox>

        <!-- The card is as tall as its content (no blank part), centred in the window -->
        <VBox styleClass="login-card" spacing="10" alignment="CENTER_LEFT"
              minWidth="360" prefWidth="360" maxWidth="360"
              minHeight="-Infinity">
            <HBox spacing="10" alignment="CENTER">
                <padding><Insets bottom="8"/></padding>
                <ImageView fitWidth="32" fitHeight="32" preserveRatio="true" smooth="true">
                    <Image url="@../icons/bms-64.png"/>
                </ImageView>
                <Label fx:id="titleLabel" styleClass="login-title" wrapText="true"/>
            </HBox>

            <Label fx:id="usernameLabel" labelFor="$usernameField"/>
            <TextField fx:id="usernameField"/>

            <Label fx:id="passwordLabel" labelFor="$passwordField"/>
            <PasswordField fx:id="passwordField" onAction="#onLogin"/>

            <Label fx:id="errorLabel" styleClass="error-label" wrapText="true" visible="false" managed="false"/>

            <!-- Login and (N1) the registration page, side by side, equal width -->
            <HBox spacing="10">
                <Button fx:id="loginButton" styleClass="login-button" maxWidth="Infinity" prefWidth="0"
                        HBox.hgrow="ALWAYS" defaultButton="true" onAction="#onLogin"/>
                <Button fx:id="registerButton" styleClass="register-button" maxWidth="Infinity" prefWidth="0"
                        HBox.hgrow="ALWAYS" onAction="#onRegister"/>
            </HBox>

            <Label fx:id="forgotLabel" styleClass="login-subtitle" wrapText="true"/>
        </VBox>
    </VBox>
</StackPane>
